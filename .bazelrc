# Some of these values might be irrelvant to bazel-common, which doesn't publish Java artifacts of its own.
# But I'm putting them in here anyway because they're our standard flags from our other projects.

build --java_language_version=8 --tool_java_language_version=25
build --java_runtime_version=25 --tool_java_runtime_version=25
build --@rules_java//toolchains:incompatible_language_version_bootclasspath
build --javacopt="-Xlint:-options"

build --experimental_one_version_enforcement=error

test --test_env=TZ=UTC
